NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=replace_only_in_vercel
# Optional legacy fallback. Use one server-side admin key, never expose it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# OBRIGATORIO: Chave secreta independente para assinar tokens de embed.
# NUNCA reutilize SUPABASE_SECRET_KEY ou SUPABASE_SERVICE_ROLE_KEY aqui.
EMBED_ORIGIN_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel Cron: gere um segredo longo. A Vercel envia Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Relatorios operacionais do aplicativo. O SMTP do Supabase atende somente Auth;
# para e-mails do Next.js configure uma chave do Resend e um remetente verificado.
RESEND_API_KEY=
REPORT_EMAIL_FROM="Prisma Player <relatorios@seudominio.com>"

# AbacatePay: somente backend. Nunca use prefixo NEXT_PUBLIC_.
ABACATEPAY_API_KEY=
# Segredo aleatorio incluido na URL do webhook configurado no painel.
ABACATEPAY_WEBHOOK_SECRET=
# OBRIGATORIO: Chave publica HMAC para verificar assinatura dos webhooks.
# Nao deixe o padrao hardcoded — configure explicitamente.
ABACATEPAY_PUBLIC_KEY=

# NVIDIA API Catalog / NIM: somente backend. A chave nunca chega ao navegador.
NVIDIA_API_KEY=
NVIDIA_AI_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_AI_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Cloudflare R2 (somente backend). Crie um token limitado ao bucket de videos.
CLOUDFLARE_R2_ACCOUNT_ID=
# Opcional: use apenas se o bucket exigir endpoint jurisdicional (ex.: UE).
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=prisma-videos
# Limite por arquivo em bytes. Padrao da aplicacao: 20 GiB.
R2_MAX_UPLOAD_BYTES=21474836480
